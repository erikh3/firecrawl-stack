# Firecrawl self-host stack
# https://github.com/firecrawl/firecrawl
#
# Core config only. The postgres password is a docker secret (see README), and
# optional LLM/proxy provider settings live in llm.env / proxy.env.

# --- Compose --------------------------------------------------------------
# https://docs.docker.com/compose/how-tos/environment-variables/envvars/
COMPOSE_PROJECT_NAME=firecrawl-stack
COMPOSE_IGNORE_ORPHANS=true
# The stack is profile-gated; pre-enabled so `docker compose up -d` just works.
COMPOSE_PROFILES=firecrawl

# --- Images ---------------------------------------------------------------
# Only the api image publishes semver tags; the sidecars publish only `latest`.
FIRECRAWL_IMAGE=ghcr.io/firecrawl/firecrawl
FIRECRAWL_TAG=2.11.202

PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service
PLAYWRIGHT_TAG=latest

NUQ_POSTGRES_IMAGE=ghcr.io/firecrawl/nuq-postgres
NUQ_POSTGRES_TAG=latest

SEARXNG_IMAGE=searxng/searxng
SEARXNG_TAG=latest

REDIS_IMAGE=redis
REDIS_TAG=alpine

RABBITMQ_IMAGE=rabbitmq
RABBITMQ_TAG=3-management

# --- API exposure ---------------------------------------------------------
HOST_PORT=31002      # host bind (127.0.0.1 only), used by AI agents
INTERNAL_PORT=3002   # api port inside the container

# --- Auth -----------------------------------------------------------------
USE_DB_AUTHENTICATION=false  # trusted-localhost run: no API key

# --- PostgreSQL (NuQ queue) ----------------------------------------------
# Internal-only (private net, no host port). Password is a docker secret.
# Keep POSTGRES_DB=postgres: the bundled pg_cron config targets that database.
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# --- Secrets --------------------------------------------------------------
# Directory holding the required `postgres-password` secret file (see README).
# Optional openai-api-key / proxy-password are env-sourced, no files needed.
SECRETS_BASE_DIR=~/.config/custom/firecrawl-stack
FIRECRAWL_SECRETS_BASE_DIR=${SECRETS_BASE_DIR}/secrets

# --- Concurrency (AI agents run only a few concurrent calls) --------------
NUQ_WORKER_COUNT=1        # nuq queue workers spawned by the harness (default 5)
NUM_WORKERS_PER_QUEUE=2
CRAWL_CONCURRENT_REQUESTS=3
MAX_CONCURRENT_JOBS=2
BROWSER_POOL_SIZE=2

# --- Resource limits ------------------------------------------------------
FIRECRAWL_API_CPUS=2.0
FIRECRAWL_API_MEM=3G    # ~6 node procs (NUQ_WORKER_COUNT=1); fits a ~6.3GiB Docker VM
PLAYWRIGHT_CPUS=1.0     # lower to 0.5 for minimal use (slower JS rendering)
PLAYWRIGHT_MEM=1G

# --- SearXNG (/search provider) ------------------------------------------
SEARXNG_UWSGI_WORKERS=2
SEARXNG_UWSGI_THREADS=2

# --- Logging / misc -------------------------------------------------------
LOGGING_LEVEL=INFO
RESTART=unless-stopped
